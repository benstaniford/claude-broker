#!/bin/bash
# Build the claude-broker .deb: build-deb <version> [out-dir]
#
#   scripts/build-deb 0.1.0            → dist/claude-broker_0.1.0_all.deb
#   scripts/build-deb v0.1.0 /tmp/out  (a leading v is dropped)
#
# The package holds the program as one zipapp (/usr/bin/claude-broker), the systemd user
# unit and the docs. DEB_MAINTAINER sets the Maintainer field.

set -euo pipefail

VERSION="${1:?usage: build-deb <version> [out-dir]}"
VERSION="${VERSION#v}"
if [[ ! "$VERSION" =~ ^[0-9][0-9A-Za-z.+~-]*$ ]]; then
  echo "build-deb: '$VERSION' isn't a Debian version" >&2
  exit 2
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${2:-$ROOT/dist}"
MAINTAINER="${DEB_MAINTAINER:-Ben Staniford <benstaniford@users.noreply.github.com>}"
PYTHON="${PYTHON:-python3}"

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
PKG="$STAGE/claude-broker_${VERSION}_all"
APP="$STAGE/app"

# The program: the package plus a __main__ that exits with main()'s status.
mkdir -p "$APP"
cp -r "$ROOT/claude_broker" "$APP/"
find "$APP" -name __pycache__ -type d -prune -exec rm -rf {} +
printf 'VERSION = "%s"\n' "$VERSION" > "$APP/claude_broker/_version.py"
printf 'import sys\nfrom claude_broker.cli import main\nsys.exit(main())\n' > "$APP/__main__.py"

mkdir -p "$PKG/DEBIAN" "$PKG/usr/bin" "$PKG/usr/lib/systemd/user" "$PKG/usr/share/doc/claude-broker"
"$PYTHON" -m zipapp "$APP" -p "/usr/bin/python3" -c -o "$PKG/usr/bin/claude-broker"
chmod 0755 "$PKG/usr/bin/claude-broker"
install -m 0644 "$ROOT/packaging/claude-broker.service" "$PKG/usr/lib/systemd/user/claude-broker.service"
install -m 0644 "$ROOT/README.md" "$PKG/usr/share/doc/claude-broker/README.md"
install -m 0644 "$ROOT/claude_broker/client.py" "$PKG/usr/share/doc/claude-broker/claude_broker_client.py"
install -m 0644 "$ROOT/claude_broker/fake_broker.py" "$PKG/usr/share/doc/claude-broker/fake_broker.py"
{
  echo "Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/"
  echo "Upstream-Name: claude-broker"
  echo "Source: https://github.com/benstaniford/claude-broker"
  echo
  echo "Files: *"
  echo "License: GPL-3"
  echo
  cat "$ROOT/LICENSE"
} > "$PKG/usr/share/doc/claude-broker/copyright"
chmod 0644 "$PKG/usr/share/doc/claude-broker/copyright"

SIZE="$(du -sk "$PKG/usr" | cut -f1)"
sed -e "s|@VERSION@|$VERSION|" -e "s|@SIZE@|$SIZE|" -e "s|@MAINTAINER@|$MAINTAINER|" \
  "$ROOT/packaging/control.in" > "$PKG/DEBIAN/control"
find "$PKG" -type d -exec chmod 0755 {} +

mkdir -p "$OUT"
dpkg-deb --build --root-owner-group "$PKG" "$OUT/claude-broker_${VERSION}_all.deb" >/dev/null
echo "$OUT/claude-broker_${VERSION}_all.deb"
